# AeroResilience Backend Environment Configuration
# OpenAQ API v3 Secret Key (obtain free key from https://openaq.org)
OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY

# OpenAQ API v3 Base URL
OPENAQ_BASE_URL=https://api.openaq.org/v3

# Operational mode: true for synthetic demo, false for live OpenAQ
DEMO_MODE=true

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
