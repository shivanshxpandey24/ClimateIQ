# AeroResilience — Environmental Intelligence Platform Configuration

# Optional: ArcGIS Developer API Key from https://developers.arcgis.com
VITE_ARCGIS_API_KEY=

# Backend API URL (default proxies through Vite to localhost:8000)
VITE_API_BASE_URL=/api

# Default data mode ('live' for real OpenAQ observations, 'demo' for synthetic telemetry)
VITE_DATA_MODE=live

# Backend OpenAQ API v3 Key (set in backend/.env)
# OPENAQ_API_KEY=YOUR_OPENAQ_API_KEY
